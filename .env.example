# .env.example — VEDD AI Trading Vault
# Key NAMES only. NEVER commit real values. Copy to `.env` and fill in.
# `.env` is gitignored and must stay that way. Secrets live in Render env in prod.

# ── Core ─────────────────────────────────────────────────────────────────────
DATABASE_URL=                       # Postgres connection string (Render Postgres)
SESSION_SECRET=                     # Express session signing secret
APP_URL=                            # Public app URL, e.g. https://veddbuild.com

# ── Encryption keys (MUST match across web service + crypto cron) ─────────────
API_KEY_ENCRYPTION_SECRET=          # encrypts user-stored API keys
CRYPTOCOM_ENCRYPTION_KEY=           # AES key for broker passwords + wallet keys (cryptocom.ts). 32+ chars
TRADELOCKER_ENCRYPTION_KEY=         # TradeLocker credential encryption

# ── AI providers (at least one vision-capable key needed for FX confirmation) ─
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
AI_INTEGRATIONS_OPENAI_API_KEY=     # platform OpenAI key (fallback path)
AI_INTEGRATIONS_OPENAI_BASE_URL=

# ── Market data ──────────────────────────────────────────────────────────────
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
SOLANA_RPC_URL=

# ── Crypto engine / DeFi (set in Render; often NOT in local .env) ────────────
ENABLE_CRYPTO_ENGINE=false          # web service: keep false — the crypto CRON is the sole owner (2 copies = OOM)
ZEROX_API_KEY=                      # 0x Swap API — required for DeFi on-chain swaps
ALCHEMY_API_KEY=                    # optional: full-token on-chain balances (else key-free RPC majors only)
WALLETCONNECT_PROJECT_ID=           # optional: WalletConnect mobile (cloud.reown.com)
POOL_WALLET_PRIVATE_KEY=            # ⚠️ tokenomics pool wallet key — sensitive, handle with care
VEDD_RECEIVER_WALLET=
VEDD_TOKEN_MINT=

# ── Payments ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=        # client-exposed (VITE_*) — publishable, not secret
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=

# ── Notifications / integrations ─────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
REPLICATE_API_TOKEN=                # AI video/reel generation

# ── Runtime (Render) ─────────────────────────────────────────────────────────
# NODE_OPTIONS=--max-old-space-size=3072   # set in Render for the 4GB instance; not a .env secret
